{
  "name": "waaree-solar-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted WAAREE PV Hub / FoxESS solar dashboard with live generation, weather forecasts, history, power-cut detection and PWA support. Runs on Cloudflare Workers.",
  "license": "MIT",
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "predev": "npm run sync-assets",
    "predeploy": "npm run sync-assets",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "predeploy:live": "npm run sync-assets",
    "deploy:live": "wrangler deploy -c wrangler.live.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "wrangler": "^4.140.0"
  }
}
